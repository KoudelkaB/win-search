<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="search.App"
             Name="File Search Manager"
             RequestedThemeVariant="Light">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <!-- Dark content stays readable on the softer blue accent. -->
                    <SolidColorBrush x:Key="AccentContentBrush" Color="#173B50" />
                    <StaticResource x:Key="AccentButtonForeground" ResourceKey="AccentContentBrush" />
                    <StaticResource x:Key="AccentButtonForegroundPointerOver" ResourceKey="AccentContentBrush" />
                    <StaticResource x:Key="AccentButtonForegroundPressed" ResourceKey="AccentContentBrush" />
                    <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="AccentContentBrush" />
                    <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="AccentContentBrush" />
                    <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="AccentContentBrush" />
                    <StaticResource x:Key="CheckBoxCheckGlyphForegroundChecked" ResourceKey="AccentContentBrush" />
                    <StaticResource x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" ResourceKey="AccentContentBrush" />
                    <StaticResource x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" ResourceKey="AccentContentBrush" />
                    <StaticResource x:Key="CheckBoxCheckGlyphForegroundIndeterminate" ResourceKey="AccentContentBrush" />
                    <StaticResource x:Key="CheckBoxCheckGlyphForegroundIndeterminatePointerOver" ResourceKey="AccentContentBrush" />
                    <StaticResource x:Key="CheckBoxCheckGlyphForegroundIndeterminatePressed" ResourceKey="AccentContentBrush" />
                    <SolidColorBrush x:Key="HyperlinkButtonForeground" Color="#24668C" />
                    <StaticResource x:Key="HyperlinkButtonForegroundPointerOver" ResourceKey="HyperlinkButtonForeground" />
                    <StaticResource x:Key="HyperlinkButtonForegroundPressed" ResourceKey="AccentContentBrush" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme DensityStyle="Compact">
            <!-- Soft blue selection and lighter neutral surfaces, closer to the WPF UI. -->
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Light" Accent="#6BB9DE" BaseLow="#14000000" />
                <ColorPaletteResources x:Key="Dark" Accent="#0078D7" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />

        <!-- A file manager shows many rows: keep the classic desktop density -->
        <Style Selector="Window">
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Button">
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ToggleButton">
            <Setter Property="Padding" Value="4,1" />
            <Setter Property="MinHeight" Value="22" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Padding" Value="5,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Padding" Value="6,1" />
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="MinHeight" Value="22" />
        </Style>
        <Style Selector="MenuItem">
            <Setter Property="Padding" Value="8,3" />
        </Style>

        <Style Selector="DataGrid">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="RowHeight" Value="21" />
            <Setter Property="GridLinesVisibility" Value="None" />
        </Style>
        <Style Selector="DataGridColumnHeader">
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Padding" Value="6,0,2,0" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="DataGridCell">
            <Setter Property="MinHeight" Value="20" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="DataGridCell TextBlock.cell">
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- Green dot when idle, spinning blue dashed circle while busy -->
        <Style Selector="Ellipse.indicator">
            <Setter Property="Width" Value="11" />
            <Setter Property="Height" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="LimeGreen" />
            <Setter Property="RenderTransform" Value="rotate(0deg)" />
        </Style>
        <Style Selector="Ellipse.indicator.busy">
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="Stroke" Value="DodgerBlue" />
            <Setter Property="StrokeThickness" Value="2.5" />
            <Setter Property="StrokeDashArray" Value="2,1.2" />
            <Style.Animations>
                <Animation Duration="0:0:1" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="RotateTransform.Angle" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="RotateTransform.Angle" Value="360" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </Application.Styles>
</Application>
