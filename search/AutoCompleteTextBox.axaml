<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="search.AutoCompleteTextBox">
    <Panel>
        <TextBox x:Name="TextBox" />
        <Popup x:Name="autoListPopup"
               PlacementTarget="{Binding #TextBox}"
               Placement="BottomEdgeAlignedLeft"
               IsLightDismissEnabled="True"
               MinWidth="200">
            <Border Background="{DynamicResource SystemControlBackgroundChromeWhiteBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                    BorderThickness="1">
                <ListBox x:Name="autoList" MaxHeight="300"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="6,2" />
                            <Setter Property="MinHeight" Value="20" />
                        </Style>
                    </ListBox.Styles>
                </ListBox>
            </Border>
        </Popup>
    </Panel>
</UserControl>
