<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:search"
        x:Class="search.DrivesWindow"
        Title="{local:Loc Key=IndexedDrives}"
        SizeToContent="WidthAndHeight"
        CanResize="False"
        CanMinimize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="12" MinWidth="380">
        <TextBlock TextWrapping="Wrap" MaxWidth="460" Text="{local:Loc Key=ChooseDrives}"/>
        <ScrollViewer MaxHeight="520" Margin="0,10,0,0">
            <ItemsControl x:Name="drivesList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="0,3,0,0" VerticalContentAlignment="Center">
                            <TextBlock>
                                <Run FontWeight="SemiBold" Text="{Binding Root, Mode=OneWay}"/>
                                <Run Text="  "/>
                                <Run Text="{Binding Details, Mode=OneWay}"/>
                            </TextBlock>
                        </CheckBox>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <!-- Linux: the optional file system service (live changes, every file for administrators) -->
        <StackPanel x:Name="servicePanel" IsVisible="False" Margin="0,12,0,0" MaxWidth="460">
            <CheckBox x:Name="showAllFiles" VerticalContentAlignment="Center">
                <TextBlock TextWrapping="Wrap" Text="{local:Loc Key=ShowAllFiles}"/>
            </CheckBox>
            <TextBlock x:Name="serviceState" TextWrapping="Wrap" FontSize="11" Opacity="0.75" Margin="0,4,0,0"
                       Text="{local:Loc Key=Checking}"/>
        </StackPanel>
        <WrapPanel HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{local:Loc Key=OK}" MinWidth="80" Margin="3" IsDefault="True" Classes="accent" Click="Ok_Click"/>
            <Button Content="{local:Loc Key=Cancel}" MinWidth="70" Margin="3" IsCancel="True" Click="Cancel_Click"/>
        </WrapPanel>
    </StackPanel>
</Window>
