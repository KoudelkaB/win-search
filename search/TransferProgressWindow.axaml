<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:search"
        x:Class="search.TransferProgressWindow"
        Title="{local:Loc Key=FileOperation}"
        Width="560"
        SizeToContent="Height"
        CanResize="False"
        CanMinimize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="12">
        <TextBlock x:Name="Operation" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock x:Name="CurrentItem" TextWrapping="Wrap" Margin="0,6"/>
        <ProgressBar x:Name="Progress"
                     Height="18"
                     Minimum="0"
                     Maximum="100"
                     Foreground="#FF16A34A"
                     Margin="0,4,0,4"/>
        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,2">
            <TextBlock x:Name="ProgressText"/>
            <TextBlock x:Name="BytesText" Grid.Column="2"/>
        </Grid>
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
            <TextBlock x:Name="ElapsedText"/>
            <TextBlock x:Name="RemainingText" Grid.Column="1"/>
        </Grid>
        <Button x:Name="CancelButton"
                Content="{local:Loc Key=Cancel}"
                MinWidth="80"
                HorizontalAlignment="Right"
                HorizontalContentAlignment="Center"
                Click="Cancel_Click"/>
    </StackPanel>
</Window>
