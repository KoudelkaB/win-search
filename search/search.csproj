<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- No spaces: the executable keeps a plain name on every platform. The application is
         still shown as "File Search Manager" (window title, shortcuts, desktop entry). -->
    <AssemblyName>FileSearchManager</AssemblyName>
    <RootNamespace>search</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <StartupObject>search.Program</StartupObject>
    <NeutralLanguage>en</NeutralLanguage>
    <!-- NativeControlHost needs the supported-OS declaration for layered child HWNDs. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <!-- The Microsoft WebView2 Core wrapper uses built-in COM interop on Windows. -->
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Windows-only code paths (MFT, USN journal, service, UAC broker) are guarded by
         OperatingSystem.IsWindows() at run time; the analyzer cannot follow those guards
         across the static helpers, so its warnings would only be noise here. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <!-- The Win32 icon only exists in a Windows apphost -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == '' Or $(RuntimeIdentifier.StartsWith('win'))">
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <None Include="FodyWeavers.xsd" />
    <None Include="..\docs\HELP*.md" Link="Docs\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- HTML apps hosted by WebAppWindow, shipped next to the exe so they work offline.
         external/singleHtmlApps is a git submodule: local builds use the pinned commit, the
         release workflow moves it to the latest upstream commit before publishing. -->
    <None Include="..\external\singleHtmlApps\HexEditorAndComparer.html;..\external\singleHtmlApps\LogExplorer.html;..\external\singleHtmlApps\calculator.html" Link="WebApps\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\external\singleHtmlApps\LICENSE" Link="WebApps\LICENSE.singleHtmlApps.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Licenses travel with the app on every platform: its own, the third-party summary, and the
       verbatim notices of the native SkiaSharp/HarfBuzzSharp libraries (Skia, FreeType, libpng,
       libjpeg-turbo, zlib, the Adobe DNG SDK...) and of a bundled .NET runtime. Those two come
       from the very packages the build uses, so they always match their versions. -->
  <ItemGroup>
    <None Include="..\LICENSE;..\THIRD-PARTY-NOTICES.md" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Both resolutions first (AfterTargets would run it after whichever of them comes first),
       and before AssignTargetPaths gathers the files to copy -->
  <Target Name="AddPackageNotices" DependsOnTargets="ResolvePackageAssets;ResolveRuntimePackAssets" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <!-- The same file in every SkiaSharp and HarfBuzzSharp native package, which share SkiaSharp's
           version; the Linux one is restored on every platform -->
      <_SkiaVersion Include="@(RuntimeCopyLocalItems->'%(NuGetPackageVersion)')" Condition="'%(RuntimeCopyLocalItems.NuGetPackageId)' == 'SkiaSharp'" />
      <_SkiaNotices Include="@(_SkiaVersion->Distinct()->'$(NuGetPackageRoot)skiasharp.nativeassets.linux/%(Identity)/THIRD-PARTY-NOTICES.txt')" />
      <_RuntimeNotices Include="@(ResolvedRuntimePack->'%(PackageDirectory)/THIRD-PARTY-NOTICES.TXT')" Condition="'$(SelfContained)' == 'true' And '%(ResolvedRuntimePack.FrameworkName)' == 'Microsoft.NETCore.App'" />
      <None Include="@(_SkiaNotices)" Condition="Exists('%(FullPath)')" Link="licenses/SkiaSharp-THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
      <None Include="@(_RuntimeNotices)" Condition="Exists('%(FullPath)')" Link="licenses/dotnet-THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
    <Error Condition="'@(_SkiaNotices)' == ''" Text="SkiaSharp's THIRD-PARTY-NOTICES.txt was not found - the native library notices must ship with the app." />
  </Target>

  <!-- Linux: the file system service's scripts and unit next to the app. Settings installs the
       service from them, and a release can be set up by hand with sudo ./install-service.sh. -->
  <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('linux')) Or ('$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('Linux')))">
    <None Include="..\installer\linux\install-service.sh;..\installer\linux\uninstall-service.sh;..\installer\linux\file-search-manager.service" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The WebView2 package always references its WPF and WinForms controls; only its Core
       interop is used (behind Avalonia's NativeWebView), and the WPF one drags in WindowsBase -->
  <Target Name="DropWebView2UiReferences" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf' Or '%(Filename)' == 'Microsoft.Web.WebView2.WinForms'" />
    </ItemGroup>
  </Target>

  <!-- A clone made without submodules has no web apps - fetch the pinned commit instead of failing the copy -->
  <Target Name="InitWebAppsSubmodule" BeforeTargets="BeforeBuild" Condition="!Exists('..\external\singleHtmlApps\LogExplorer.html')">
    <Exec Command="git submodule update --init external/singleHtmlApps" WorkingDirectory="$(MSBuildProjectDirectory)\.." />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\search.core\search.core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="search.tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.1.1" />
    <PackageReference Include="NonBlocking" Version="2.1.2" />
    <PackageReference Include="PropertyChanged.Fody" Version="4.1.0" PrivateAssets="All" />
    <PackageReference Include="SharpCompress" Version="0.50.4" />
    <!-- WebView2 interop on Windows: the CoreWebView2 behind Avalonia's NativeWebView -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

</Project>
